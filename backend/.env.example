# Copy this file to .env and fill in your values

# ── Required ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Google OAuth ──
# GOOGLE_CLIENT_ID=your_google_client_id_here

# ── Optional: Admin panel access (comma-separated emails) ──
# ADMIN_EMAILS=you@gmail.com,coadmin@gmail.com

# ── Optional: Password Reset & Reminder Email ──
# Preferred for cloud deploys (Render/Railway block SMTP ports) — use Resend HTTP API:
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=LectureDigest <onboarding@resend.dev>
#
# Alternative for LOCAL dev only (SMTP is blocked on most cloud hosts):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=your_email@gmail.com

# ── Optional: Production settings ──
# ALLOWED_ORIGINS=https://lecturedigest.onrender.com,https://your-custom-domain.com
# APP_BASE_URL=https://lecturedigest.onrender.com
# JWT_SECRET=set_a_strong_random_secret_in_production
# Set TRUST_PROXY=true ONLY when running behind a trusted reverse proxy
# (Render/Railway/Fly/nginx). It makes rate limiting read the X-Forwarded-For
# header. Leave unset for local/dev so the spoofable header is ignored.
# TRUST_PROXY=true

# ── Optional: YouTube anti-block (cloud deploy) ──
# YOUTUBE_COOKIES_B64=base64_encoded_cookies_txt
# YOUTUBE_PROXY_URL=http://user:pass@host:port
